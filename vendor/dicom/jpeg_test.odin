@(test)
test_jpeg_image_info_and_errors :: proc (t: ^testing.T) {
	frags := [][]u8{jpeg_test_baseline[:]}
	buf := build_encapsulated_file(frags, 3, 3, 3, 8, 1, false, JPEG_BASELINE_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	info, err := jpeg_image_info(&doc, pixel)
	testing.expect_value(t, err, JPEG_Error.None)
	testing.expect_value(t, info.rows, 3)
	testing.expect_value(t, info.cols, 3)
	testing.expect_value(t, info.samples, 3)
	testing.expect_value(t, info.bits, 8)
	testing.expect_value(t, info.frames, 1)
	testing.expect_value(t, info.frame_bytes, 27)

	// Wrong transfer syntax (not a supported JPEG syntax).
	bad_ts := build_encapsulated_file(frags, 3, 3, 3, 8, 1, false, "1.2.840.10008.1.2.1")
	defer delete(bad_ts)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(bad_ts[:], &doc2)
	testing.expect_value(t, f2, true)
	_, e2 := jpeg_image_info(&doc2, p2)
	testing.expect_value(t, e2, JPEG_Error.Not_JPEG_Transfer_Syntax)

	// Missing image attributes.
	no_attrs := build_encapsulated_file(frags, 3, 3, 3, 8, 1, false, JPEG_BASELINE_UID, false)
	defer delete(no_attrs)
	doc3: Document
	defer document_destroy(&doc3)
	p3, f3 := open_test_j2k(no_attrs[:], &doc3)
	testing.expect_value(t, f3, true)
	_, e3 := jpeg_image_info(&doc3, p3)
	testing.expect_value(t, e3, JPEG_Error.Missing_Image_Attributes)

	dst := make([]u8, 8)
	defer delete(dst)
	n, e4 := jpeg_decode(&doc, pixel, dst)
	testing.expect_value(t, n, 0)
	testing.expect_value(t, e4, JPEG_Error.Output_Too_Small)
}

@(test)
test_jpeg_baseline_byte_exact :: proc (t: ^testing.T) {
	frags := [][]u8{jpeg_test_baseline[:]}
	buf := build_encapsulated_file(frags, 3, 3, 3, 8, 1, false, JPEG_BASELINE_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 27)
	defer delete(dst)
	_, err := jpeg_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JPEG_Error.None)
	// Oracle (pydicom.pixel_array raw, this file is byte-exact).
	testing.expect_value(t, fnv1a64(dst), u64(0x77e1b2b7f6825ced))
	testing.expect_value(t, dst[0], u8(138))
	testing.expect_value(t, dst[1], u8(78))
	testing.expect_value(t, dst[2], u8(147))
	// Second row starts at sample 9 (3 pixels * 3 components).
	testing.expect_value(t, dst[9], u8(90))
	testing.expect_value(t, dst[10], u8(178))
	testing.expect_value(t, dst[11], u8(108))
}

@(test)
test_jpeg_lossless_byte_exact_and_split :: proc (t: ^testing.T) {
	frags := [][]u8{jpeg_test_lossless[:]}
	buf := build_encapsulated_file(frags, 100, 100, 3, 8, 1, false, JPEG_LOSSLESS_SV1_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 100 * 100 * 3)
	defer delete(dst)
	_, err := jpeg_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JPEG_Error.None)
	testing.expect_value(t, fnv1a64(dst), u64(0xe9719e4c815ac1dd))

	// Same codestream split over two fragments with an empty BOT.
	half := len(jpeg_test_lossless) / 2
	split := [][]u8{jpeg_test_lossless[:half], jpeg_test_lossless[half:]}
	buf2 := build_encapsulated_file(split, 100, 100, 3, 8, 1, false, JPEG_LOSSLESS_SV1_UID)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 100 * 100 * 3)
	defer delete(dst2)
	_, e2 := jpeg_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, JPEG_Error.None)
	testing.expect_value(t, fnv1a64(dst2), u64(0xe9719e4c815ac1dd))
}

@(test)
test_jpeg_error_paths :: proc (t: ^testing.T) {
	// Garbage: SOI then truncated data must be rejected, not crash.
	garbage := [4]u8{0xFF, 0xD8, 0xFF, 0xDB}
	frags := [][]u8{garbage[:]}
	buf := build_encapsulated_file(frags, 3, 3, 3, 8, 1, false, JPEG_BASELINE_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 27)
	defer delete(dst)
	_, err := jpeg_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JPEG_Error.Bad_Codestream)

	// Progressive (SOF2) is not supported for encapsulated DICOM JPEG.
	prog := make([]u8, len(jpeg_test_baseline))
	defer delete(prog)
	copy(prog, jpeg_test_baseline[:])
	for i in 0 ..< len(prog) - 1 {
		if prog[i] == 0xFF && prog[i + 1] == 0xC0 {
			prog[i + 1] = 0xC2
			break
		}
	}
	frags2 := [][]u8{prog[:]}
	buf2 := build_encapsulated_file(frags2, 3, 3, 3, 8, 1, false, JPEG_BASELINE_UID)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 27)
	defer delete(dst2)
	_, e2 := jpeg_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, JPEG_Error.Unsupported_Feature)
}
