@(private)
fnv1a64 :: proc "contextless" (b: []u8) -> u64 {
	h: u64 = 0xcbf29ce484222325
	for x in b {
		h ~= u64(x)
		h *= 0x100000001b3
	}
	return h
}

@(private)
J2K_TEST_FNV :: u64(0x51433421a5f7529a)

// Builds an encapsulated J2K DICOM file with the given PixelData fragments.
@(private)
build_encapsulated_file :: proc(
	fragments: [][]u8,
	rows, cols, samples, bits, frames: int,
	signed: bool,
	ts_uid := J2K_UID,
	with_attributes := true,
	bot_offsets: []u32 = {},
	photometric := "",
) -> [dynamic]u8 {
	buf := init_dicom_preamble(ts_uid)
	if with_attributes {
		if photometric != "" do add_text_elem(&buf, Tag{0x0028, 0x0004}, "CS", photometric, .Little)
		add_us_elem(&buf, Tag{0x0028, 0x0010}, u16(rows))
		add_us_elem(&buf, Tag{0x0028, 0x0011}, u16(cols))
		add_us_elem(&buf, Tag{0x0028, 0x0002}, u16(samples))
		add_us_elem(&buf, Tag{0x0028, 0x0100}, u16(bits))
		add_us_elem(&buf, Tag{0x0028, 0x0103}, u16(1) if signed else u16(0))
		add_is_elem(&buf, Tag{0x0028, 0x0008}, "1 " if frames == 1 else "2 ")
	}
	put_tag(&buf, TAG_PIXEL_DATA, .Little)
	append(&buf, 'O', 'B', 0, 0)
	put_u32(&buf, UNDEFINED_LENGTH, .Little)
	// Basic Offset Table item (empty unless offsets are supplied).
	put_tag(&buf, TAG_ITEM, .Little)
	if len(bot_offsets) > 0 {
		put_u32(&buf, u32(4 * len(bot_offsets)), .Little)
		for off in bot_offsets {
			put_u32(&buf, off, .Little)
		}
	} else {
		put_u32(&buf, 0, .Little)
	}
	for f in fragments {
		put_tag(&buf, TAG_ITEM, .Little)
		put_u32(&buf, u32(len(f)), .Little)
		append(&buf, ..f)
	}
	put_tag(&buf, TAG_SEQ_DELIMITATION, .Little)
	put_u32(&buf, 0, .Little)
	return buf
}

@(private)
open_test_j2k :: proc(buf: []u8, doc: ^Document) -> (Element, bool) {
	document_init(doc)
	if document_parse_buffer(doc, buf) != .None do return {}, false
	return document_find(doc, TAG_PIXEL_DATA)
}

@(test)
test_j2k_image_info_and_errors :: proc (t: ^testing.T) {
	frags := [][]u8{j2k_test_stream[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	info, err := j2k_image_info(&doc, pixel)
	testing.expect_value(t, err, J2K_Error.None)
	testing.expect_value(t, info.rows, 64)
	testing.expect_value(t, info.cols, 64)
	testing.expect_value(t, info.samples, 1)
	testing.expect_value(t, info.bits, 16)
	testing.expect_value(t, info.signed, true)
	testing.expect_value(t, info.frames, 1)
	testing.expect_value(t, info.frame_bytes, 64 * 64 * 2)

	// Wrong transfer syntax.
	bad_ts := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true, "1.2.840.10008.1.2.1")
	defer delete(bad_ts)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(bad_ts[:], &doc2)
	testing.expect_value(t, f2, true)
	_, e2 := j2k_image_info(&doc2, p2)
	testing.expect_value(t, e2, J2K_Error.Not_J2K_Transfer_Syntax)

	// Missing image attributes.
	no_attrs := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true, J2K_UID, false)
	defer delete(no_attrs)
	doc3: Document
	defer document_destroy(&doc3)
	p3, f3 := open_test_j2k(no_attrs[:], &doc3)
	testing.expect_value(t, f3, true)
	_, e3 := j2k_image_info(&doc3, p3)
	testing.expect_value(t, e3, J2K_Error.Missing_Image_Attributes)

	// Output buffer too small is rejected before any decoding.
	dst := make([]u8, 16)
	defer delete(dst)
	n, e4 := j2k_decode(&doc, pixel, dst)
	testing.expect_value(t, n, 0)
	testing.expect_value(t, e4, J2K_Error.Output_Too_Small)
}

@(test)
test_j2k_decode_byte_exact_single_frame :: proc (t: ^testing.T) {
	frags := [][]u8{j2k_test_stream[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 64 * 64 * 2)
	defer delete(dst)
	n, err := j2k_decode(&doc, pixel, dst)
	testing.expect_value(t, err, J2K_Error.None)
	testing.expect_value(t, n, 64 * 64 * 2)
	testing.expect_value(t, fnv1a64(dst), J2K_TEST_FNV)
	// Oracle (pydicom): first row, int16 little-endian.
	v0, _ := endian.get_u16(dst[0:2], .Little)
	v1, _ := endian.get_u16(dst[2:4], .Little)
	v2, _ := endian.get_u16(dst[4:6], .Little)
	testing.expect_value(t, v0, u16(905))
	testing.expect_value(t, v1, u16(1019))
	testing.expect_value(t, v2, u16(1227))
}

@(test)
test_j2k_multi_frame_bot_and_split_fragments :: proc (t: ^testing.T) {
	// Two frames with a Basic Offset Table: both must decode identically.
	frags := [][]u8{j2k_test_stream[:], j2k_test_stream[:]}
	// PS3.5 A.4: offsets are measured from the first Item Tag, so each fragment's
	// payload is preceded by its 8-byte item header.
	offsets := [2]u32{8, u32(8 + 8 + len(j2k_test_stream))}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 2, true, J2K_UID, true, offsets[:])
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 2 * 64 * 64 * 2)
	defer delete(dst)
	n, err := j2k_decode(&doc, pixel, dst)
	testing.expect_value(t, err, J2K_Error.None)
	testing.expect_value(t, n, 2 * 64 * 64 * 2)
	testing.expect_value(t, fnv1a64(dst[0:64 * 64 * 2]), J2K_TEST_FNV)
	testing.expect_value(t, fnv1a64(dst[64 * 64 * 2:]), J2K_TEST_FNV)

	// One frame split across two fragments, empty BOT (DICOM allows this).
	half := len(j2k_test_stream) / 2
	split := [][]u8{j2k_test_stream[:half], j2k_test_stream[half:]}
	buf2 := build_encapsulated_file(split, 64, 64, 1, 16, 1, true)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 64 * 64 * 2)
	defer delete(dst2)
	_, e2 := j2k_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, J2K_Error.None)
	testing.expect_value(t, fnv1a64(dst2), J2K_TEST_FNV)
}

@(test)
test_j2k_error_paths :: proc (t: ^testing.T) {
	// Garbage codestream: SOC + truncated SIZ must be rejected, not crash.
	garbage := [8]u8{0xFF, 0x4F, 0xFF, 0x51, 0x00, 0x04, 0x00, 0x00}
	frags := [][]u8{garbage[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 64 * 64 * 2)
	defer delete(dst)
	n, err := j2k_decode(&doc, pixel, dst)
	testing.expect_value(t, n, 0)
	testing.expect_value(t, err, J2K_Error.Bad_Codestream)

	// Valid SOC/SIZ but 9/7 transform (not allowed for lossless .90): unsupported.
	lossy := make([]u8, len(j2k_test_stream))
	defer delete(lossy)
	copy(lossy, j2k_test_stream[:])
	i := 0
	for i + 14 <= len(lossy) {
		if lossy[i] == 0xFF && lossy[i + 1] == 0x52 {
			lossy[i + 13] = 0 // SPcod transform = 9/7 irreversible
			break
		}
		i += 1
	}
	testing.expect_value(t, i + 14 <= len(lossy), true)
	frags2 := [][]u8{lossy[:]}
	buf2 := build_encapsulated_file(frags2, 64, 64, 1, 16, 1, true)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 64 * 64 * 2)
	defer delete(dst2)
	_, e2 := j2k_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, J2K_Error.Unsupported_Feature)
}

// Wraps the embedded codestream in a minimal JP2 file (signature + jp2c box). GDCM-era
// encoders wrote this inside DICOM PixelData even though the standard requires a raw
// codestream, so the decoder must unwrap it.
@(private)
build_jp2_wrapper :: proc(cs: []u8) -> [dynamic]u8 {
	out := make([dynamic]u8, 0, len(cs) + 32)
	append(&out, 0x00, 0x00, 0x00, 0x0C, 'j', 'P', ' ', ' ', 0x0D, 0x0A, 0x87, 0x0A)
	put_u32(&out, u32(len(cs) + 8), .Big)
	append(&out, 'j', 'p', '2', 'c')
	append(&out, ..cs)
	return out
}

// Rewrites the single tile-part into two tile-parts covering the same continuous packet
// stream, with TPsot 0/1 and matching Psot values.
@(private)
build_multi_tilepart :: proc(cs: []u8) -> [dynamic]u8 {
	sot := -1
	for i in 0 ..< len(cs) - 1 {
		if cs[i] == 0xFF && cs[i + 1] == 0x90 {
			sot = i
			break
		}
	}
	assert(sot >= 0 && sot + 14 <= len(cs))
	eoc := len(cs) - 2
	assert(cs[eoc] == 0xFF && cs[eoc + 1] == 0xD9)
	tile := cs[sot + 14:eoc]
	half := len(tile) / 2

	out := make([dynamic]u8, 0, len(cs) + 24)
	append(&out, ..cs[:sot])
	for part in 0 ..< 2 {
		data := tile[:half] if part == 0 else tile[half:]
		put_u16(&out, 0xFF90, .Big) // SOT
		put_u16(&out, 10, .Big)     // Lsot
		put_u16(&out, 0, .Big)      // Isot
		put_u32(&out, u32(14 + len(data)), .Big) // Psot
		append(&out, u8(part), 2) // TPsot, TNsot
		put_u16(&out, 0xFF93, .Big) // SOD
		append(&out, ..data)
	}
	put_u16(&out, 0xFFD9, .Big) // EOC
	return out
}

@(test)
test_j2k_jp2_wrapper_and_multi_tilepart :: proc (t: ^testing.T) {
	// JP2 box unwrap: jp2c payload is the codestream itself.
	unwrapped := j2k_unwrap_jp2(j2k_test_stream[:])
	testing.expect_value(t, len(unwrapped), len(j2k_test_stream))
	testing.expect_value(t, unwrapped[0], u8(0xFF))
	testing.expect_value(t, unwrapped[1], u8(0x4F))

	jp2 := build_jp2_wrapper(j2k_test_stream[:])
	defer delete(jp2)
	testing.expect_value(t, len(j2k_unwrap_jp2(jp2[:])), len(j2k_test_stream))

	frags := [][]u8{jp2[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, true)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 64 * 64 * 2)
	defer delete(dst)
	_, err := j2k_decode(&doc, pixel, dst)
	testing.expect_value(t, err, J2K_Error.None)
	testing.expect_value(t, fnv1a64(dst), J2K_TEST_FNV)

	// Same codestream split into two tile-parts must decode identically.
	multi := build_multi_tilepart(j2k_test_stream[:])
	defer delete(multi)
	frags2 := [][]u8{multi[:]}
	buf2 := build_encapsulated_file(frags2, 64, 64, 1, 16, 1, true)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 64 * 64 * 2)
	defer delete(dst2)
	_, e2 := j2k_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, J2K_Error.None)
	testing.expect_value(t, fnv1a64(dst2), J2K_TEST_FNV)
}
