package dicom

import "core:sort"
import "core:testing"

@(test)
test_dictionary_ordering_and_lookup :: proc(t: ^testing.T) {
	// Table size and strict ascending order invariant required by the binary search
	testing.expect(t, len(DICOM_DICT) > 5000)
	testing.expect_value(t, len(DICOM_REPEATERS), 88)
	for i in 1 ..< len(DICOM_DICT) {
		if DICOM_DICT[i - 1].tag >= DICOM_DICT[i].tag {
			testing.fail_now(t, "DICOM_DICT is not strictly sorted")
		}
	}

	// Exact standard tags
	testing.expect_value(t, lookup_vr(Tag{0x0008, 0x1115}), VR.SQ)    // ReferencedSeriesSequence
	testing.expect_value(t, lookup_vr(Tag{0x0010, 0x0010}), VR.PN)    // PatientName
	testing.expect_value(t, lookup_vr(Tag{0x7FE0, 0x0010}), VR.OB_OW) // PixelData

	// Repeating groups / elements (present only in PS3.6 RepeatersDictionary)
	testing.expect_value(t, lookup_vr(Tag{0x5004, 0x2600}), VR.SQ)    // (50xx,2600)
	testing.expect_value(t, lookup_vr(Tag{0x6002, 0x3000}), VR.OB_OW) // (60xx,3000) OverlayData
	testing.expect_value(t, lookup_vr(Tag{0x0020, 0x3142}), VR.CS)    // (0020,31xx)
	testing.expect_value(t, lookup_vr(Tag{0x0028, 0x0410}), VR.US)    // (0028,04x0)
	testing.expect_value(t, lookup_vr(Tag{0x1000, 0x0120}), VR.US)    // (1000,xxx0)

	// Special and private rules
	testing.expect_value(t, lookup_vr(Tag{0xFFFE, 0xE000}), VR.ITEM)
	testing.expect_value(t, lookup_vr(Tag{0x0008, 0x0000}), VR.UL)    // Group Length
	testing.expect_value(t, lookup_vr(Tag{0x0009, 0x0010}), VR.LO)    // Private Creator
	testing.expect_value(t, lookup_vr(Tag{0x0009, 0x1001}), VR.UN)    // Private Data
	testing.expect_value(t, lookup_vr(Tag{0x6001, 0x3000}), VR.UN)    // Odd group 6001 is private, not Overlay
}

// Exhaustive agreement with pydicom's dictionary_VR() over every exact tag plus every
// even-group expansion of every repeater mask (samples 0,1,8,F per 'x' nibble).
// The expected value is a FNV-1a/64 constant generated by tools/gen_dict.py.
@(test)
test_dictionary_exhaustive_pydicom_agreement :: proc(t: ^testing.T) {
	samples := [4]u32{0x0, 0x1, 0x8, 0xF}

	tags := make([dynamic]u32, 0, DICT_PROBE_COUNT + 128)
	defer delete(tags)

	for e in DICOM_DICT {
		if (e.tag & 0xFFFF) == 0 do continue // Group Length is UL by rule
		append(&tags, e.tag)
	}
	for r in DICOM_REPEATERS {
		shifts: [8]u32
		n := 0
		for i in 0 ..< 8 {
			shift := u32((7 - i) * 4)
			if (r.mask >> shift) & 0xF == 0 {
				shifts[n] = shift
				n += 1
			}
		}
		combos := 1
		for _ in 0 ..< n do combos *= 4
		for c in 0 ..< combos {
			tag := r.val
			acc := c
			for k in 0 ..< n {
				d := samples[acc & 3]
				acc >>= 2
				tag = (tag &~ (u32(0xF) << shifts[k])) | (d << shifts[k])
			}
			if ((tag >> 16) & 1) == 1 do continue // odd group == private, not a dictionary entry
			if (tag & 0xFFFF) == 0 do continue      // (gggg,0000) Group Length is UL by rule
			append(&tags, tag)
		}
	}

	sort.quick_sort(tags[:])

	FNV_OFFSET :: u64(0xCBF29CE484222325)
	FNV_PRIME :: u64(0x100000001B3)

	h := FNV_OFFSET
	count := 0
	prev: u32
	have_prev := false
	for tag in tags {
		if have_prev && tag == prev do continue
		prev = tag
		have_prev = true
		count += 1

		vr := lookup_vr(tag_from_u32(tag))
		bytes := [4]u8{u8(tag >> 24), u8(tag >> 16), u8(tag >> 8), u8(tag)}
		for byte in bytes {
			h = (h ~ u64(byte)) * FNV_PRIME
		}
		h = (h ~ u64(vr)) * FNV_PRIME
	}

	testing.expect_value(t, count, DICT_PROBE_COUNT)
	testing.expectf(t, h == DICT_PROBE_FNV, "dictionary mismatch vs pydicom: fnv=0x%016X expected=0x%016X", h, DICT_PROBE_FNV)
}
