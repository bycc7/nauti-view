// 45x10 8-bit JPEG-LS near-lossless (NEAR=2), 56 bytes.
@(private)
jls_test_near := [56]u8{
	0xff, 0xd8, 0xff, 0xf7, 0x00, 0x0b, 0x08, 0x00, 0x2d, 0x00, 0x0a, 0x01, 0x01, 0x11, 0x00, 0xff,
	0xda, 0x00, 0x08, 0x01, 0x01, 0x00, 0x02, 0x00, 0x00, 0x57, 0xfd, 0xff, 0x7f, 0x00, 0x00, 0x00,
	0x71, 0xff, 0x7f, 0xe0, 0xb7, 0xff, 0x7c, 0x1c, 0xff, 0x7f, 0x05, 0x2f, 0xfb, 0xe0, 0x97, 0xff,
	0x7f, 0xc1, 0x17, 0xfd, 0xff, 0x40, 0xff, 0xd9,}

@(test)
test_jls_image_info_and_errors :: proc (t: ^testing.T) {
	frags := [][]u8{jls_test_lossless[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, false, JPEG_LS_LOSSLESS_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	info, err := jls_image_info(&doc, pixel)
	testing.expect_value(t, err, JLS_Error.None)
	testing.expect_value(t, info.rows, 64)
	testing.expect_value(t, info.cols, 64)
	testing.expect_value(t, info.samples, 1)
	testing.expect_value(t, info.bits, 16)
	testing.expect_value(t, info.frame_bytes, 8192)

	// Wrong transfer syntax.
	bad := build_encapsulated_file(frags, 64, 64, 1, 16, 1, false, "1.2.840.10008.1.2.1")
	defer delete(bad)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(bad[:], &doc2)
	testing.expect_value(t, f2, true)
	_, e2 := jls_image_info(&doc2, p2)
	testing.expect_value(t, e2, JLS_Error.Not_JPEG_LS_Transfer_Syntax)

	dst := make([]u8, 8)
	defer delete(dst)
	n, e3 := jls_decode(&doc, pixel, dst)
	testing.expect_value(t, n, 0)
	testing.expect_value(t, e3, JLS_Error.Output_Too_Small)
}

@(test)
test_jls_lossless_byte_exact :: proc (t: ^testing.T) {
	frags := [][]u8{jls_test_lossless[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, false, JPEG_LS_LOSSLESS_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 64 * 64 * 2)
	defer delete(dst)
	_, err := jls_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JLS_Error.None)
	testing.expect_value(t, fnv1a64(dst), u64(0x51433421a5f7529a))
	v0, _ := endian_get_u16_le(dst[0:2])
	testing.expect_value(t, v0, u16(905))
}

@(test)
test_jls_near_lossless_byte_exact :: proc (t: ^testing.T) {
	frags := [][]u8{jls_test_near[:]}
	buf := build_encapsulated_file(frags, 45, 10, 1, 8, 1, false, JPEG_LS_NEAR_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 45 * 10)
	defer delete(dst)
	_, err := jls_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JLS_Error.None)
	testing.expect_value(t, fnv1a64(dst), u64(0x6f43e7bb6e9e77d9))
}

@(test)
test_jls_error_paths :: proc (t: ^testing.T) {
	garbage := [4]u8{0xFF, 0xD8, 0xFF, 0xF7}
	frags := [][]u8{garbage[:]}
	buf := build_encapsulated_file(frags, 64, 64, 1, 16, 1, false, JPEG_LS_LOSSLESS_UID)
	defer delete(buf)
	doc: Document
	defer document_destroy(&doc)
	pixel, found := open_test_j2k(buf[:], &doc)
	testing.expect_value(t, found, true)
	dst := make([]u8, 64 * 64 * 2)
	defer delete(dst)
	_, err := jls_decode(&doc, pixel, dst)
	testing.expect_value(t, err, JLS_Error.Bad_Codestream)

	// Subsampled SOF55 is invalid for JPEG-LS.
	sub := make([]u8, len(jls_test_lossless))
	defer delete(sub)
	copy(sub, jls_test_lossless[:])
	for i in 0 ..< len(sub) - 1 {
		if sub[i] == 0xFF && sub[i + 1] == 0xF7 {
			// SOF55 body: marker(2) + length(2) + P(1) + Y(2) + X(2) + Nf(1)
			sub[i + 11] = 0x21 // component 0 H/V: 2x1 instead of 1x1
			break
		}
	}
	frags2 := [][]u8{sub[:]}
	buf2 := build_encapsulated_file(frags2, 64, 64, 1, 16, 1, false, JPEG_LS_LOSSLESS_UID)
	defer delete(buf2)
	doc2: Document
	defer document_destroy(&doc2)
	p2, f2 := open_test_j2k(buf2[:], &doc2)
	testing.expect_value(t, f2, true)
	dst2 := make([]u8, 64 * 64 * 2)
	defer delete(dst2)
	_, e2 := jls_decode(&doc2, p2, dst2)
	testing.expect_value(t, e2, JLS_Error.Unsupported_Feature)
}

@(private)
endian_get_u16_le :: proc "contextless" (b: []u8) -> (u16, bool) {
	v, ok := endian.get_u16(b, .Little)
	return v, ok
}
